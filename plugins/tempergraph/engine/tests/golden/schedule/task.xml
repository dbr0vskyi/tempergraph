<?xml version="1.0" encoding="UTF-8"?>
<!-- TCK-AC1 golden file: the tests drop this line before they compare -->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>999</Count>
    </RestartOnFailure>
  </Settings>
  <Actions>
    <Exec>
      <Command>C:\Users\user\.tempergraph\bin\tempergraph.cmd</Command>
      <Arguments>schedule loop</Arguments>
    </Exec>
  </Actions>
</Task>

#!/bin/sh
# The tempergraph plugin's launcher (UPD §2.7). Before the engine is installed there is no shim on PATH,
# so this runs the staged engine's bootstrap with the first real Python 3.11+ it finds. It accepts only
# `install` and `update`; every other verb exits 127 with the line to run.
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
case "$1" in
  install|update) ;;
  *) echo "tempergraph: the engine is not installed; run: $root/bin/tempergraph install" >&2; exit 127 ;;
esac
for py in "$TEMPERGRAPH_PYTHON" python3.14 python3.13 python3.12 python3.11 python3; do
  [ -n "$py" ] || continue
  command -v "$py" >/dev/null 2>&1 || continue
  if "$py" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
    PYTHONPATH="$root/engine/src" exec "$py" -m tempergraph.install.bootstrap "$@"
  fi
done
echo "tempergraph: no Python 3.11 or newer found; install one or set TEMPERGRAPH_PYTHON" >&2
exit 2

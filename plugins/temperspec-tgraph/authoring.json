  "decisions": [
    {
      "id": "d1",
      "phase": 4,
      "subject": "ts-spec-sync",
      "choice": "Accept ts-spec-sync as judged at the outcome gate with no deterministic check serving it on every step; its trust stays uncalibrated until its judge seeds are graded by a signed-in judge (author verify rung 8).",
      "alternatives": [
        "A person signs off spec agreement on every run",
        "A deterministic check for contradictions between behaviours, which no rule can express"
      ],
      "consequence": "Until rung 8 has run and the outcome judge is accepted, a contradiction between specs can pass the outcome gate on the judge's word alone; ts-dis-links (one definition per id) and ts-code-related (judged at the code gate) are the earlier lines of defence.",
      "decided_by": "agent, on the owner's approval of the blueprint and outcome on 2026-11-21; to be confirmed by the owner"
    }
  ],

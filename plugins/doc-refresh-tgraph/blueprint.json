{
  "schema_version": 1,
  "name": "doc-refresh",
  "units": [
    {
      "name": "outline",
      "kind": "script",
      "summary": "List the document's headings",
      "produces": [
        "outline"
      ],
      "gate": {
        "check": true
      }
    },
    {
      "name": "draft",
      "kind": "step",
      "summary": "Rewrite the requested sections",
      "produces": [
        "doc",
        "size"
      ],
      "reads": [
        "outline"
      ],
      "gate": {
        "check": true,
        "judge": true
      },
      "sizing": {
        "model": "medium",
        "effort": "medium",
        "why": "It rewrites named sections from the repository's files"
      },
      "judge_sizing": {
        "model": "medium",
        "effort": "medium",
        "why": "It compares the rewritten sections with the outline and the request"
      }
    },
    {
      "name": "review",
      "kind": "step",
      "summary": "Review the rewrite against the request",
      "produces": [
        "verdict"
      ],
      "reads": [
        "doc"
      ],
      "gate": {
        "judge": true,
        "signoff": true
      },
      "approval": true,
      "back_targets": [
        "draft"
      ],
      "sizing": {
        "model": "medium",
        "effort": "medium",
        "why": "It reads one document against the request and gives a verdict"
      },
      "judge_sizing": {
        "model": "medium",
        "effort": "low",
        "why": "It confirms a one-word verdict that a person then approves"
      }
    }
  ],
  "flow": {
    "draft": {
      "route": [
        "review",
        "finalizer"
      ]
    }
  },
  "input": {
    "kind": "text",
    "parameters": []
  },
